# ref-client — copy to .env (gitignored). Placeholders only; never commit real values.
# Tower (Streamable HTTP). Local: the static bearer + X-Tower-User (set by --user). AWS: the bearer is the JWT.
TOWER_URL=http://localhost:8080/mcp
TOWER_BEARER=change-me-local-bearer
# Demo controls (local only): the mock's /_admin and the binding page's local grant admin (BIND_ADMIN=1).
MOCK_URL=http://localhost:8443
BINDING_URL=http://localhost:8081
# Bedrock — the only model call in the repository. Default: Nova Micro.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_REGION=us-east-1
# auto = Bedrock when AWS credentials are configured, else the scripted agent (demo only). bedrock | scripted.
REF_AGENT=auto
# 1 = speak answers through Amazon Polly (and `ref-client say -` listens on the mic). Off by default.
REF_VOICE=0
# Corpus gate: fraction of phrasings that must select the expected tool.
CORPUS_MIN_PASS=0.9
